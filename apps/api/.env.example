# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Neon: use the POOLED connection string here (host contains "-pooler").
# sslmode=require is mandatory when NODE_ENV=production.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/haqly?sslmode=require"

# Neon: the DIRECT (non-pooled) connection string. Prisma uses it for migrations
# only; the running API never reads it. Required wherever `prisma migrate deploy`
# runs — locally, in CI, or in your deploy step.
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/haqly?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Both must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET="replace-with-a-long-random-string-at-least-32-chars"
REFRESH_TOKEN_SECRET="replace-with-a-different-long-random-string-32-chars"

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API. In production this
# must include the deployed web origin, or the browser will block every request.
ALLOWED_ORIGINS="http://localhost:3001"
