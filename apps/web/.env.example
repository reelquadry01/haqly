# Base URL of the Haqly API, including the /api/v1 version prefix.
# Local development (API on port 3000, web on 3001):
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# Production — point this at your deployed API, e.g.
# NEXT_PUBLIC_API_URL="https://haqly-api.onrender.com/api/v1"
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so this
# must be set in Vercel *before* the build runs, not at runtime.
